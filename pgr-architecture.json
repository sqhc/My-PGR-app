  "cards": [
    {
      "dot": "cyan",
      "title": "分层职责",
      "items": [
        "UI 层用 MVC：控制器 + 自定义 cell",
        "数据层只有 DataLoader 单例",
        "状态层用 UserDefaults 与通知",
        "数据源自官方 PGR 维基，离线打包进 Bundle"
      ]
    },
    {
      "dot": "violet",
      "title": "导航轴",
      "items": [
        "首页纵向 UITableView 内嵌横向 UICollectionView",
        "磁贴标题即路由键，由代理 switch 分发",
        "角色 / 组织页各自带语言菜单",
        "Items & Concepts、Developers 仍是占位磁贴"
      ]
    },
    {
      "dot": "amber",
      "title": "值得注意",
      "items": [
        "角色页与组织页各自调用 DataLoader 解析同一份 JSON",
        "模型同时保留 name 与 nameZh 双语字段",
        "语言切换靠通知中心广播后整表重载",
        "Android 侧复用同一份 GameData.json"
      ]
    }
  ]
