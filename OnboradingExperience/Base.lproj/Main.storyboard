                            </label>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" image="Solon" translatesAutoresizingMaskIntoConstraints="NO" id="kuo-5H-O3n">
                                <rect key="frame" x="77" y="494" width="240" height="128"/>
