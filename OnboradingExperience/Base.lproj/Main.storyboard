        <!--Characters-->
        <scene sceneID="Y2S-kj-uHX">
            <objects>
                <viewController storyboardIdentifier="Characters" id="4zp-da-oez" customClass="CharactersViewController" customModule="OnboradingExperience" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="ZLy-L3-23z">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" text="Lucia" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Vbf-Wc-MM6">
                                <rect key="frame" x="20" y="88" width="41" height="21"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" image="Lucia1" translatesAutoresizingMaskIntoConstraints="NO" id="t5u-ts-YRT">
                                <rect key="frame" x="20" y="117" width="89" height="86"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" image="Lucia2" translatesAutoresizingMaskIntoConstraints="NO" id="c0o-yc-RQ4">
                                <rect key="frame" x="117" y="117" width="82" height="86"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                            </imageView>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" textAlignment="natural" translatesAutoresizingMaskIntoConstraints="NO" id="zEa-nJ-j10">
                                <rect key="frame" x="20" y="211" width="374" height="144"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <string key="text">Captain of Gray Raven squad, with a characteristic of serious and persistent, one of the early batch of transforming for military constructs, forged strong srength and firm will within the long period of battlefield. Nowadays, she has uninterrupted tacit understanding with commander(player) during the fight. Though her memory has something strange, it seems that a very essential past was hidden.</string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" textAlignment="natural" translatesAutoresizingMaskIntoConstraints="NO" id="20z-Xh-6FK">
                                <rect key="frame" x="207" y="88" width="187" height="115"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" systemColor="systemRedColor"/>
                                <string key="text">Actually is not the original Lucia, her consciousness is a copy from Sky Garden.               After the battle of round city, her sea of consciousness was initialized. Therefore body of Lotus and Plume is not the same Lucia.</string>
                                <color key="textColor" systemColor="systemBackgroundColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" text="Alpha" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lPS-WA-aVF">
                                <rect key="frame" x="20" y="363" width="44" height="21"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" image="Alpha1" translatesAutoresizingMaskIntoConstraints="NO" id="Eyg-gI-t6D">
                                <rect key="frame" x="20" y="392" width="89" height="79"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" image="Alpha2" translatesAutoresizingMaskIntoConstraints="NO" id="Idb-vi-EVH">
                                <rect key="frame" x="117" y="392" width="82" height="79"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                            </imageView>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" textAlignment="natural" translatesAutoresizingMaskIntoConstraints="NO" id="cCJ-UC-LD9">
                                <rect key="frame" x="20" y="479" width="179" height="162"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <string key="text">A mysterious enemy met at City No.015, left powerful and casual impression. She seems has unusual attention to Gray Raven Squad. She is an important member of Ascendant clique which was led by Luna.</string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" textAlignment="natural" translatesAutoresizingMaskIntoConstraints="NO" id="Ern-M6-Iha">
                                <rect key="frame" x="207" y="363" width="187" height="278"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" red="0.90873427243576832" green="0.25528248371928636" blue="0.085510255439851537" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                <string key="text">The source of Lucia's consciousness which means she is the real Lucia.                                  At a large-scale seige on the ground, Ravenge who was the ex commander of Gray Raven Squad connected with an Ascendanter to seek for promotion and merit then he got infected by Punish Virus. To hide his fault, he provided false information of enemy so that Lucia and other teammates can be killed. During the fight, Ravenge destoried two other teammates' origin against device with pistol, but Lucia still managed to kill the infector with the cost of sacrifice of two other teammates and went back to Ravenge, Ravenge then reduced the power of Lucia's origin against device, Lucia then used her remaining power to cut one of his arm but went into self-hibernation mechanism after all power was spent...(Sorry, lots of thing happened after this, but don't think I have the time to finish the description) </string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" text="Thanks for the management from Chinese Wiki" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="zOZ-D3-cfn">
                                <rect key="frame" x="29" y="776" width="357" height="21"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="lK7-Sd-zzD"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="Characters" id="Z6F-3E-GYw"/>
                    <connections>
                        <outlet property="AlphaImage1" destination="Eyg-gI-t6D" id="qpo-nt-bCF"/>
                        <outlet property="HiddenTextForAlpha" destination="Ern-M6-Iha" id="VLc-jI-cZU"/>
                        <outlet property="HiddenTextForLucia" destination="20z-Xh-6FK" id="iB1-JP-6Fi"/>
                        <outlet property="LuciaImage1" destination="t5u-ts-YRT" id="aSs-1A-BKf"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="8Qc-0r-7MQ" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1869.5652173913045" y="-470.08928571428567"/>
        </scene>
        <!--Organizations-->
        <scene sceneID="VaG-kP-Jsa">
            <objects>
                <viewController storyboardIdentifier="Organizations" id="6bj-H6-gYD" customClass="OrganizationsViewController" customModule="OnboradingExperience" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="fIP-Hr-AgN">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" text="Gray Raven Squad" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ob9-ud-zSQ">
                                <rect key="frame" x="20" y="88" width="140" height="21"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
